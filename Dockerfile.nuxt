
FROM node:22-bookworm-slim

WORKDIR /usr/src/app

# Install all dependencies (devDeps included — required by nuxt build at startup).
# Use --chown at copy time to avoid a slow chown -R layer.
COPY --chown=node:node package*.json ./
RUN npm install --no-audit --no-fund && npm cache clean --force

# Copy application sources (ownership set at copy time, no extra layer).
COPY --chown=node:node . .
COPY --chown=node:node ./env_sample ./.env

USER node

EXPOSE 3000

# At pod startup Kubernetes injects env vars (ConfigMap/Secret).
# Nuxt reads NUXT_PUBLIC_* and other vars during build, so we rebuild first.
CMD ["sh", "-c", "npm run build && node .output/server/index.mjs"]
