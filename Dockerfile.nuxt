
FROM node:22-bookworm-slim AS builder

WORKDIR /usr/src/app
ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}

# Install only production dependencies required for build/runtime output generation.
COPY package*.json ./
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force

COPY . .
COPY ./env_sample /usr/src/app/.env

RUN npm run build


FROM node:22-bookworm-slim AS runner

WORKDIR /usr/src/app
ENV NODE_ENV=production

# Copy only runtime artifacts and set ownership during copy (no expensive chown -R).
COPY --from=builder --chown=node:node /usr/src/app/.output ./.output
COPY --from=builder --chown=node:node /usr/src/app/.env ./.env

USER node

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
