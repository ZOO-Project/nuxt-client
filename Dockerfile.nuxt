
# Stage 1 — build: install all deps (incl. devDeps) and produce .output
FROM node:22-bookworm-slim AS builder

WORKDIR /usr/src/app
ENV NODE_ENV=production

COPY package*.json ./
# devDeps required for `nuxt build` (vite, rollup, sass-embedded, ...).
RUN npm install --no-audit --no-fund && npm cache clean --force

COPY . .
RUN npm run build


# Stage 2 — runtime: only Node + .output. All Nuxt config values are read
# from process.env at server startup (runtimeConfig), so no rebuild is needed
# when Kubernetes injects env vars via ConfigMap/Secret.
FROM node:22-bookworm-slim AS runner

WORKDIR /usr/src/app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
ENV NITRO_HOST=0.0.0.0
ENV NITRO_PORT=3000

# Ownership set at copy time (avoids slow `chown -R` layer).
COPY --from=builder --chown=node:node /usr/src/app/.output ./.output

USER node

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
